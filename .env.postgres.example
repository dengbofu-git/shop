# Copy to .env.postgres. Generate a private password; never commit that file.
AI_POSTGRES_HOST=127.0.0.1
AI_POSTGRES_PORT=5433
AI_POSTGRES_NAME=tea_saas_ai
AI_POSTGRES_USER=tea_saas_ai
AI_POSTGRES_PASSWORD=replace-with-a-random-password
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=bge-m3
AI_OLLAMA_REVISION=latest
AI_EMBEDDING_SPACE_KEY=bge-m3-1024-v1

# Existing installations: set these to the actual existing volume names before compose up.
AI_POSTGRES_VOLUME_NAME=tea_saas-ai-storage_postgres_data
AI_OLLAMA_VOLUME_NAME=tea_saas-ai-storage_ollama_models
AI_RERANK_VOLUME_NAME=tea_saas-reranker_reranker_models
AGENT_PROMETHEUS_VOLUME_NAME=tea_saas-agent-observability_prometheus_data
