# PostgreSQL / local model infrastructure. No real credentials.
# Existing volumes keep their existing database, user and password.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_NAME=tea_saas
POSTGRES_USER=tea_saas
POSTGRES_PASSWORD=
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=bge-m3
AI_OLLAMA_REVISION=latest
AI_EMBEDDING_SPACE_KEY=bge-m3-1024-v1
AI_RERANK_BASE_URL=http://127.0.0.1:18081
# Preserve volume names when adopting an existing installation.
AI_POSTGRES_VOLUME_NAME=tea_saas-ai-storage_postgres_data
AI_OLLAMA_VOLUME_NAME=tea_saas-ai-storage_ollama_models
