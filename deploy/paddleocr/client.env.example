# Copy settings to .scratch/paddleocr/client.env; never commit the real API key.
AI_PADDLEOCR_BASE_URL=http://paddleocr:8080
AI_PADDLEOCR_ALLOW_HTTP_HOSTS=paddleocr
AI_PADDLEOCR_MODEL=PaddleOCR-VL-1.6-0.9B
# Copy identity.revision from authenticated GET /ready after this service is ready.
AI_PADDLEOCR_REVISION=replace-with-64-character-revision
AI_PADDLEOCR_API_KEY=replace-with-generated-local-key
AI_PADDLEOCR_TIMEOUT_SECONDS=300
AI_PADDLEOCR_MAX_IMAGE_BYTES=10000000
AI_PADDLEOCR_MAX_OUTPUT_TOKENS=4096
