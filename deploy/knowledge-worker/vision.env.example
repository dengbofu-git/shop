# 把需要的配置项追加到现有本地 .env；不要覆盖文件或提交真实密钥。
# 配置不代表启用：每个导入还须显式 --vision-mode auto/force。默认 off。
AI_VISION_PROVIDER=openai_compatible
AI_VISION_BASE_URL=https://vision-provider.invalid/v1
AI_VISION_API_KEY=replace-with-local-secret
AI_VISION_MODEL=replace-with-vision-model
AI_VISION_REVISION=replace-with-pinned-or-recorded-revision

# 只按供应商已验证能力配置；不自动降级或猜测参数。
AI_VISION_OUTPUT_FORMAT=json_object
AI_VISION_TOKEN_PARAMETER=max_tokens
AI_VISION_IMAGE_DETAIL=omit
AI_VISION_THINKING=omit
AI_VISION_TEMPERATURE=omit
AI_VISION_TIMEOUT_SECONDS=90
AI_VISION_MAX_ATTEMPTS=2
AI_VISION_CONCURRENCY=2
AI_VISION_MAX_OUTPUT_TOKENS=4096
AI_VISION_MAX_IMAGE_BYTES=10000000
AI_VISION_MAX_PAGES=20
AI_VISION_MAX_CALLS=40
AI_VISION_PROMPT_VERSION=vision-prompt-v1
