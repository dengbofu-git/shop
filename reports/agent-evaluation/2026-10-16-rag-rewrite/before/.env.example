# 复制为 .env 并填写真实值（.env 勿提交 Git）
# 说明见 docs/环境配置.md

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- MySQL（需本地或远程实例，库需先 CREATE DATABASE） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dadashop
DB_USER=root
DB_PASSWORD=your_mysql_password

# ---------- JWT / 管理账号初始密码 ----------
JWT_SECRET_KEY=change-me-jwt-secret
ADMIN_INITIAL_PASSWORD=Admin@123456
CUSTOMS_INITIAL_PASSWORD=Customs@123456

# ---------- 买家 AI 客服（OpenAI 兼容接口） ----------
SUPPORT_API_KEY=
SUPPORT_MODEL=gpt-4o-mini
SUPPORT_BASE_URL=https://api.openai.com/v1
# 可选，留空即可
SUPPORT_THINKING=

# ---------- SMTP 邮件（注册激活、找回密码） ----------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---------- 短信（容联云；本地开发建议 MOCK） ----------
SMS_MOCK_MODE=true
RONGLIAN_SMS_ACCOUNT_ID=
RONGLIAN_SMS_ACCOUNT_TOKEN=
RONGLIAN_SMS_APP_ID=
RONGLIAN_SMS_MODEL_ID=

# ---------- 微博 OAuth（未启用可填占位） ----------
WEIBO_APP_KEY=
WEIBO_APP_SECRET=
WEIBO_REDIRECT_URI=http://127.0.0.1:8000/callback.html

# ---------- 支付宝沙箱 / 生产 ----------
ALIPAY_PAY_URL=https://openapi.alipaydev.com/gateway.do
ALIPAY_APP_ID=
# 应用私钥 PEM 全文（单行可用 \n 转义，或团队约定从文件粘贴）
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_NOTIFY_URL=http://127.0.0.1:8000/v1/pays/notify
FRONTEND_BASE_URL=http://127.0.0.1:8000

# 本地重排序服务；模型选择和检索参数在 Agent 运营设置中管理。
AI_RERANK_BASE_URL=http://127.0.0.1:18081
AI_RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# RAG 查询翻译、同义词扩展、多查询融合与一次补检（无需迁移）。
SUPPORT_RAG_QUERY_ENABLED=true
SUPPORT_RAG_MAX_QUERIES=4
# 整个客服请求最多两次改写模型调用；每次5秒、无SDK重试。
SUPPORT_RAG_REWRITE_CALLS=2
SUPPORT_RAG_REWRITE_TIMEOUT=5
SUPPORT_RAG_RETRY_ENABLED=true
# 附加操作的派发预算；正在执行的本地向量调用仍使用自身超时。
SUPPORT_RAG_BUDGET_SECONDS=25
# 仅触发补检的启发式分数，不作为正确率或最终证据过滤阈值。
SUPPORT_RAG_WEAK_SCORE=0.1
