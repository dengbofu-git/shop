# tea_saas configuration template. Contains no real credentials.
# Copy to .env only when that file does not already exist, then fill locally.
# Never copy actual .env values back into this template or commit real secrets.
# Empty secrets must be supplied before starting the application.

# Django and authentication: use different, independently generated secrets.
DJANGO_SECRET_KEY=
JWT_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
ADMIN_INITIAL_PASSWORD=
FRONTEND_BASE_URL=http://127.0.0.1:8000

# MySQL: example database/user names only; create and configure your own instance.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tea_saas_example
DB_USER=example_user
DB_PASSWORD=

# Redis: public local defaults; set the password privately if authentication is used.
REDIS_CACHE_URL=redis://127.0.0.1:6379/0
REDIS_CARTS_URL=redis://127.0.0.1:6379/1
REDIS_PASSWORD=

# Buyer support: configure an OpenAI-compatible provider before using model features.
# The reserved .invalid domain below is deliberately unusable.
SUPPORT_BASE_URL=https://model-api.example.invalid/v1
SUPPORT_MODEL=
SUPPORT_API_KEY=
SUPPORT_THINKING=

# Optional RAG settings: defaults from tea_saas/settings.py.
SUPPORT_RAG_QUERY_ENABLED=true
SUPPORT_RAG_QUERY_LANGUAGES=zh,en
SUPPORT_RAG_MAX_QUERIES=4
SUPPORT_RAG_REWRITE_CALLS=1
SUPPORT_RAG_REWRITE_TIMEOUT=5
SUPPORT_RAG_RETRY_ENABLED=true
SUPPORT_RAG_BUDGET_SECONDS=25
SUPPORT_RAG_WEAK_SCORE=0.1
SUPPORT_RAG_HYBRID_ENABLED=true
SUPPORT_RAG_RERANK_CANDIDATES=20
SUPPORT_RAG_CACHE_ENABLED=true
SUPPORT_RAG_CACHE_TTL=300
SUPPORT_RAG_SINGLE_CONTEXT_CHARS=3000
SUPPORT_RAG_MULTI_CONTEXT_CHARS=8000

# Optional local knowledge services. These local addresses are code defaults.
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=bge-m3
AI_OLLAMA_REVISION=latest
AI_EMBEDDING_SPACE_KEY=bge-m3-1024-v1
AI_RERANK_BASE_URL=http://127.0.0.1:18081
# Use the code default for AI_RERANK_REVISION unless changing the deployed model.
# Manage AI_POSTGRES_* privately in .env.postgres or the process environment.
# Do not duplicate those variables here: .env loads first, even for empty values.
# Optional OCR/vision adapters have separate templates under deploy/.

# Payment: retain these keys even when unused; no usable merchant credentials here.
# Replace the .invalid endpoint only when configuring your payment environment.
ALIPAY_PAY_URL=https://payment.example.invalid/gateway.do
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_NOTIFY_URL=http://127.0.0.1:8000/v1/pays/notify
# Supply the application private key only in private runtime configuration.
# Do not place PEM key bodies in this file.

# Optional runtime logging: console only; do not log configuration or secrets.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=false
